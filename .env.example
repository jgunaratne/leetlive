# ── Gemini Auth (pick ONE) ────────────────────────────────────────────────
# Option 1 — API key
GEMINI_API_KEY=

# Option 2 — Vertex AI via ADC (run: gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Server ───────────────────────────────────────────────────────────────
# PORT=3000

# ── Gemini Live tuning ───────────────────────────────────────────────────
# Silence (ms) before Gemini treats your turn as finished. Lower = snappier
# replies, higher = more room to think out loud without being cut off.
# LIVE_SILENCE_MS=700
# LIVE_END_SENSITIVITY=END_SENSITIVITY_HIGH

# Speech (ms) that must be detected before a turn starts. Raise it only if you
# get false triggers from background noise — too high and short replies like
# "ok" are discarded before the model ever hears them.
# LIVE_PREFIX_PADDING_MS=20

# How often the proxy pings idle browser sockets to keep them from being reaped.
# LIVE_PING_INTERVAL_MS=20000
